# 복사해서 .env 로 쓰거나, export 로 셸에 직접 넣으세요.
# (python -m collector 실행 시 .env 를 자동으로 읽습니다.)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 발급처: legacy(developers.naver.com, 기본) | apihub(NAVER API HUB / ncloud)
# API HUB 키를 받았다면 apihub 로 바꿔야 헤더·엔드포인트가 맞습니다.
NAVER_API_STYLE=legacy

# 엔드포인트만 따로 덮어쓸 때만 지정합니다. (헤더는 NAVER_API_STYLE 을 따름)
# NAVER_DATALAB_ENDPOINT=https://openapi.naver.com/v1/datalab/search
